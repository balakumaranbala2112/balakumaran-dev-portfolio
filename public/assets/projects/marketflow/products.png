<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F19"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1F2937" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#111827" stop-opacity="0.95"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="20" stdDeviation="25" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="url(#bg)"/>
  
  <!-- Subtle Grid Pattern -->
  <g opacity="0.05" stroke="#FFFFFF" stroke-width="1">
    <path d="M0 100 H1200 M0 200 H1200 M0 300 H1200 M0 400 H1200 M0 500 H1200 M0 600 H1200 M0 700 H1200" />
    <path d="M100 0 V800 M200 0 V800 M300 0 V800 M400 0 V800 M500 0 V800 M600 0 V800 M700 0 V800 M800 0 V800 M900 0 V800 M1000 0 V800 M1100 0 V800" />
  </g>

  <!-- Top App Navigation Header Bar -->
  <rect x="60" y="40" width="1080" height="60" rx="12" fill="#1F2937" filter="url(#shadow)" stroke="#374151" stroke-width="1"/>
  
  <!-- Window Controls -->
  <circle cx="95" cy="70" r="6" fill="#EF4444"/>
  <circle cx="115" cy="70" r="6" fill="#F59E0B"/>
  <circle cx="135" cy="70" r="6" fill="#10B981"/>
  
  <!-- Search/URL Bar -->
  <rect x="180" y="55" width="400" height="30" rx="6" fill="#111827" stroke="#374151"/>
  <text x="200" y="75" fill="#9CA3AF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13">https://localhost:3000/products-catalog</text>
  
  <!-- Status Badge -->
  <rect x="980" y="55" width="130" height="30" rx="15" fill="url(#accent)"/>
  <text x="1045" y="75" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" text-anchor="middle">CATALOG</text>

  <!-- Main Canvas Container -->
  <rect x="60" y="120" width="1080" height="620" rx="16" fill="url(#cardGrad)" filter="url(#shadow)" stroke="#374151" stroke-width="1"/>

  <!-- Left Sidebar Layout -->
  <rect x="90" y="150" width="220" height="560" rx="10" fill="#111827" stroke="#1F2937"/>
  <rect x="110" y="180" width="180" height="36" rx="8" fill="url(#accent)"/>
  <text x="200" y="203" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="700" text-anchor="middle">Products Catalog</text>
  
  <rect x="110" y="240" width="180" height="12" rx="4" fill="#374151"/>
  <rect x="110" y="264" width="140" height="12" rx="4" fill="#374151"/>
  <rect x="110" y="288" width="160" height="12" rx="4" fill="#374151"/>

  <rect x="110" y="340" width="180" height="1" fill="#374151"/>

  <!-- Feature Tags in Sidebar -->
  
    <rect x="110" y="360" width="180" height="32" rx="6" fill="#1F2937" stroke="#374151"/>
    <text x="125" y="381" fill="#E5E7EB" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12">Price Filters</text>
  
    <rect x="110" y="404" width="180" height="32" rx="6" fill="#1F2937" stroke="#374151"/>
    <text x="125" y="425" fill="#E5E7EB" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12">Brand Filter</text>
  
    <rect x="110" y="448" width="180" height="32" rx="6" fill="#1F2937" stroke="#374151"/>
    <text x="125" y="469" fill="#E5E7EB" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12">Stock Status</text>
  
    <rect x="110" y="492" width="180" height="32" rx="6" fill="#1F2937" stroke="#374151"/>
    <text x="125" y="513" fill="#E5E7EB" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12">Rating Filter</text>
  

  <!-- Main Content Area -->
  <text x="340" y="190" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800">Products Catalog Dashboard</text>
  <text x="340" y="220" fill="#9CA3AF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15">Indexed Search, Multi-Filter, Sorting & Paginated Grid</text>

  <!-- Metric Cards Row -->
  <g stroke="#374151" stroke-width="1">
    <rect x="340" y="250" width="240" height="110" rx="12" fill="#111827"/>
    <text x="365" y="285" fill="#9CA3AF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600">SYSTEM STATUS</text>
    <text x="365" y="325" fill="#10B981" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="24" font-weight="800">Operational 100%</text>

    <rect x="600" y="250" width="240" height="110" rx="12" fill="#111827"/>
    <text x="625" y="285" fill="#9CA3AF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600">ACTIVE USERS</text>
    <text x="625" y="325" fill="#60A5FA" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="24" font-weight="800">1,482 Real-time</text>

    <rect x="860" y="250" width="240" height="110" rx="12" fill="#111827"/>
    <text x="885" y="285" fill="#9CA3AF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600">LATENCY</text>
    <text x="885" y="325" fill="#F59E0B" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="24" font-weight="800">&lt; 38ms API</text>
  </g>

  <!-- Interactive Data / Content Box -->
  <rect x="340" y="385" width="760" height="300" rx="12" fill="#111827" stroke="#374151"/>

  <!-- Mock Graph / Code Lines -->
  <polyline points="370,620 440,560 520,580 600,480 680,520 760,440 840,470 920,410 1060,430" fill="none" stroke="#3B82F6" stroke-width="4" stroke-linecap="round"/>
  <polygon points="370,620 440,560 520,580 600,480 680,520 760,440 840,470 920,410 1060,430 1060,640 370,640" fill="#3B82F6" opacity="0.1"/>

  <!-- Graph Grid Horizontal lines -->
  <line x1="370" y1="450" x2="1060" y2="450" stroke="#1F2937" stroke-dasharray="4 4"/>
  <line x1="370" y1="510" x2="1060" y2="510" stroke="#1F2937" stroke-dasharray="4 4"/>
  <line x1="370" y1="570" x2="1060" y2="570" stroke="#1F2937" stroke-dasharray="4 4"/>

  <!-- Bottom Bar -->
  <text x="370" y="665" fill="#6B7280" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12">Production Stack • MongoDB • Express • React • Node.js</text>
</svg>