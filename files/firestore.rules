// firestore.rules
// ─────────────────────────────────────────────────────────────
// Security rules for bk-dev-portfolio Firestore
//
// Public: projects, blogs (read-only)
// Private: messages, _rateLimits (no client access — Functions only)
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Projects: public read, no client write ──────────────
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false; // managed via Cloud Functions / Admin SDK
    }

    // ── Blogs: public read, no client write ─────────────────
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Messages: no client access (Functions only) ─────────
    match /messages/{messageId} {
      allow read, write: if false;
    }

    // ── Rate limits: no client access (Functions only) ──────
    match /_rateLimits/{doc} {
      allow read, write: if false;
    }

    // ── Deny everything else ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
