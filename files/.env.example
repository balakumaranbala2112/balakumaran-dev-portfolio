# .env.example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────

# Firebase Web App config
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Cloud Functions base URL
# For local dev (emulator): http://127.0.0.1:5001/your-project-id/us-central1
# For production: https://us-central1-your-project-id.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/your-project-id/us-central1
